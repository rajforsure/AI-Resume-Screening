# ==============================================================================
# AI Resume Screening & Ranking System - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Choose between: "groq", "gemini", "openai", or "heuristic"
LLM_PROVIDER=groq

# Groq API Key & Model (Ultra-fast inference)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Key (if using Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (if using OpenAI / OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# GitHub API Token (Optional, increases rate limit from 60/hr to 5,000/hr)
GITHUB_TOKEN=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
